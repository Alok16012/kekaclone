# Hosted demo / single-company install (Vercel + Supabase). Copy the values into Vercel → Project → Environment Variables.
# Local copy for `pnpm deploy:db` goes in .env.deploy (git-ignored). Never commit real values.

# --- Workspace ---
ERP_DEFAULT_TENANT=acme                 # every host serves this one workspace (no wildcard subdomains on *.vercel.app); sign-up is off
ROOT_DOMAIN=erp-demo.vercel.app         # the public host (no scheme); emails, QR codes and SSO redirects use it
ERP_DEMO=1                              # demo only: keeps /dev/mail and /dev/sms readable in production so invites / OTPs can be seen
SESSION_COOKIE=erp_session

# --- Database (Supabase → Project Settings → Database → Connection string) ---
# App: transaction-mode pooler (port 6543, IPv4) as the RLS-bound app role. Owner: session-mode pooler (port 5432).
DATABASE_URL=postgres://erp_app_user.<project-ref>:<ERP_APP_DB_PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_ADMIN_URL=postgres://postgres.<project-ref>:<db-password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_POOL_MAX=5
ERP_APP_DB_PASSWORD=                    # deploy:db sets this on the erp_app_user role (generate: openssl rand -hex 24)

# --- Secrets ---
ERP_DATA_KEY=                           # openssl rand -hex 32 (encrypts bank account numbers at rest)
CRON_SECRET=                            # openssl rand -hex 24; Vercel sends it as Authorization: Bearer on cron calls

# --- Files (Supabase → Project Settings → API) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=erp-files

# --- Optional integrations (features read "not configured" until set) ---
# RESEND_API_KEY=                       # outbound email; without it, mail stays queued (readable at /dev/mail when ERP_DEMO=1)
# RAZORPAY_KEY_ID= RAZORPAY_KEY_SECRET= RAZORPAY_WEBHOOK_SECRET= RAZORPAY_PLAN_CORE_MONTHLY=…
# GOOGLE_CLIENT_ID= GOOGLE_CLIENT_SECRET= MICROSOFT_CLIENT_ID= MICROSOFT_CLIENT_SECRET=   # SSO redirect URI: https://<ROOT_DOMAIN>/auth/sso/<provider>/callback
# MSG91_AUTH_KEY= MSG91_TEMPLATE_ID= MSG91_SENDER=
