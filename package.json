{
  "name": "erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "tsx --env-file=.env.local db/migrate.ts",
    "db:seed": "tsx --conditions=react-server --tsconfig tsconfig.json --env-file=.env.local db/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx --conditions=react-server --tsconfig tsconfig.json --env-file=.env.local db/smoke.ts",
    "smoke:attendance": "tsx --conditions=react-server --tsconfig tsconfig.json --env-file=.env.local db/smoke-attendance.ts",
    "jobs:attendance": "tsx --conditions=react-server --tsconfig tsconfig.json --env-file=.env.local db/jobs-attendance.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.5"
}
