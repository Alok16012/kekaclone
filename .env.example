# Local development only. Never commit real secrets.
DATABASE_ADMIN_URL=postgres://postgres@localhost:54329/erp
DATABASE_URL=postgres://erp_app_user:erp_app_dev_only@localhost:54329/erp
ROOT_DOMAIN=localhost:3100
SESSION_COOKIE=erp_session
# 32-byte key (64 hex chars) that encrypts bank account numbers at rest. Dev-only example value; generate your own with: openssl rand -hex 32
ERP_DATA_KEY=6572702d6465762d6f6e6c792d6b65792d6368616e67652d6d652d6e6f772121
# --- SaaS platform (all optional; features show "not configured" until set) ---
# Razorpay Subscriptions: live/test keys, the webhook secret, and a Razorpay plan id per erp plan + cycle
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_WEBHOOK_SECRET=xxx
# RAZORPAY_PLAN_CORE_MONTHLY=plan_xxx   (also _QUARTERLY/_YEARLY, and PLUS_/PRO_)
# Single sign-on (OIDC): redirect URI is https://<workspace>.<ROOT_DOMAIN>/auth/sso/<google|microsoft>/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Mobile OTP via MSG91 (otherwise codes go to /dev/sms)
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER=
# --- plat2 (all optional; features show "not configured" until set) ---
# Slack approve / decline buttons: the Slack app's signing secret; set the app's Interactivity URL to https://<workspace>.<ROOT_DOMAIN>/api/chat/slack
# SLACK_SIGNING_SECRET=
# Calendar sync reuses GOOGLE_* / MICROSOFT_* above; redirect URIs are https://<workspace>.<ROOT_DOMAIN>/auth/calendar/<google|microsoft>/callback
# Web Push (generate locally with: pnpm push:keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
# OAuth2 access-token signing secret (defaults to a key derived from ERP_DATA_KEY)
# ERP_JWT_SECRET=
# --- round D (all optional; features show "not configured" until set) ---
# Outbound email (Resend). Without a key, emails are recorded and shown at /dev/mail.
# RESEND_API_KEY=
# EMAIL_FROM=
# File storage directory for uploads (default ./.storage)
# STORAGE_DIR=
# Receipt OCR (tesseract.js, self-hosted): a folder containing eng.traineddata
# OCR_LANG_PATH=
# Expense FX rates: a JSON endpoint answering { base, date?, rates: { USD: ... } }; otherwise finance types rates in
# FX_RATES_URL=
# AI drafting, resume scores and helpdesk answers (Claude Messages API); rule-based fallbacks without it
# ANTHROPIC_API_KEY=
# In-app scheduler (pnpm jobs:scheduler), when cron isn't available
# SCHEDULER_TIME=00:15
# SCHEDULER_TZ=Asia/Kolkata
